# Generated dataset and intermediate images: reproduce with `make all`.
# results/ is deliberately tracked instead, so the report, tables and figures
# can be read straight from the repository without a full 28-minute re-run.
# Because the run is seeded, regenerating them should produce no diff.
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
